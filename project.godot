; AtomicTux — Godot 4.6
config_version=5

[application]
config/name="AtomicTux"
config/icon="res://assets/art/tux.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A little penguin. A big chain reaction."

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=0
window/size/min_width=960
window/size/min_height=600

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.045, 0.075, 1)

[input_devices]
pointing/emulate_mouse_from_touch=false
